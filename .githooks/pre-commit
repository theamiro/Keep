#!/bin/bash

# Combined swift-format + SwiftLint pre-commit hook
# - Formats staged .swift files with swift-format (Xcode toolchain)
# - Runs SwiftLint --fix on those files
# - Re-adds them to the index
# - Lints staged files and blocks commit on remaining violations

set -euo pipefail

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[1;33m'
RESET=$'\033[0m'

command_exists() {
  command -v "$1" >/dev/null 2>&1
}

echo "🔍 Swift pre-commit checks starting..."

# Ensure swift-format is installed (ships with Xcode 16 or newer)
if ! xcrun --find swift-format >/dev/null 2>&1; then
  echo "${RED}❌ swift-format is not available.${RESET}"
  echo "   Install Xcode 16 or newer and select it with xcode-select."
  exit 1
fi

# Ensure SwiftLint is installed
if ! command_exists swiftlint; then
  echo "${RED}❌ SwiftLint is not installed.${RESET}"
  echo "   Install: https://github.com/realm/SwiftLint"
  exit 1
fi

# Collect staged Swift files safely with NUL delimiters
files=()
if type mapfile >/dev/null 2>&1; then
  mapfile -d '' -t files < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')
else
  while IFS= read -r -d '' file; do
    files+=("$file")
  done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')
fi

if [[ ${#files[@]} -eq 0 ]]; then
  echo "${YELLOW}ℹ️  No staged Swift files. Skipping swift-format & SwiftLint.${RESET}"
  exit 0
fi

# Formatting rewrites whole files and re-adds them, which would also stage unstaged hunks
if ! git diff --quiet -- "${files[@]}"; then
  echo "${RED}❌ Staged Swift files also have unstaged changes:${RESET}"
  git diff --name-only -- "${files[@]}" | sed 's/^/   /'
  echo "   Stage or stash the rest, then commit again so the formatter can re-stage whole files."
  exit 1
fi

echo "🧹 Running swift-format on staged Swift files..."
xcrun swift-format format --in-place "${files[@]}"

# Re-add formatted files to the index
git add "${files[@]}"

echo "🧹 Running SwiftLint --fix on staged Swift files..."
for file in "${files[@]}"; do
  # --quiet to only show errors if something goes wrong
  swiftlint --fix --quiet "$file" || true
done

# Re-add after SwiftLint --fix as well
git add "${files[@]}"

echo "🔎 Running SwiftLint on staged files..."
lint_failed=0
for file in "${files[@]}"; do
  if ! swiftlint lint "$file"; then
    lint_failed=1
  fi
done

if ((lint_failed)); then
  echo "${RED}❌ SwiftLint found violations. Commit aborted.${RESET}"
  echo "   Please fix the issues above (or let Xcode / SwiftLint help), then re-stage and commit again."
  exit 1
fi

echo "${GREEN}✅ swift-format & SwiftLint checks passed. Proceeding with commit.${RESET}"
exit 0
